# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Diagnostic reports (https://nodejs.org/docs/latest-v1x/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.exn
report.dated.[0-9]*.[0-9]*.[0-9]*.[0-9]*.exn
report.nearheaplimit.*.exn

# Runtime data
pids
*.pid
*.seed
*.ports

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage data used by tools like istanbul
coverage
*.lcov

# Grunt output directory
dist/

# Bower installed dependencies
bower_components/

# node_modules
node_modules/

# Packages cached by yarn
.pnp.*

# Optional files used by nodemon
.nodemonrc

# dotenv environment variables file
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript output
dist/
build/

# Compiled JavaScript files
*.js
*.js.map

# Type Definition files
*.d.ts

